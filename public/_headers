# Cache-Control for offline cold boot support
# Chromium disk cache serves these without network and without Service Worker

/
  Cache-Control: public, max-age=604800, stale-while-revalidate=31536000

/index.html
  Cache-Control: public, max-age=604800, stale-while-revalidate=31536000

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/registerSW.js
  Cache-Control: public, max-age=0, must-revalidate

/workbox-*.js
  Cache-Control: public, max-age=0, must-revalidate
