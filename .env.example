# Frontend environment variables (Vite)
VITE_GOOGLE_DRIVE_ROOT_FOLDER_ID=your-google-drive-folder-id-here

# Backend environment variables (for local development)
GOOGLE_DRIVE_API_KEY=your-google-drive-api-key-here
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-google-drive-folder-id-here
KIOSK_PIN=1234
JWT_SECRET=REDACTED_JWT_SECRET

# Production (Cloudflare Workers)
# Set these in Cloudflare Workers dashboard:
# - GOOGLE_DRIVE_API_KEY
# - GOOGLE_DRIVE_ROOT_FOLDER_ID
# - KIOSK_PIN
# - JWT_SECRET
